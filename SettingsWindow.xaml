<Window
    x:Class="ControllerHelper.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#101218" RequestedTheme="Dark">
        <Grid.Resources>
            <SolidColorBrush x:Key="CardBrush" Color="#1D2029" />
            <SolidColorBrush x:Key="MutedBrush" Color="#A8ADBD" />
            <SolidColorBrush x:Key="AccentBrush" Color="#B8A6FF" />
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F1FF" />
            </Style>
            <Style x:Key="AccentActionButton" TargetType="Button">
                <Setter Property="Background" Value="#B8A6FF" />
                <Setter Property="Foreground" Value="#1B1626" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="4,9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="38" Background="#101218">
            <TextBlock Text="ControllerHelper" Margin="17,0,0,0" VerticalAlignment="Center"
                       Foreground="#F4F1FF" FontSize="12" FontWeight="SemiBold" />
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18,10,18,12">
                <StackPanel x:Name="PcPanel" Spacing="12">
                    <TextBlock Text="Настройка ПК" Style="{StaticResource SectionTitle}" Margin="4,2,0,0" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Мониторы" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Выберите экраны рабочего места. Телевизор в этот список не входит."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <ListView x:Name="MonitorList" SelectionMode="Multiple" MinHeight="110"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            <Button Content="Сохранить раскладку ПК" Click="Capture_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Аудиовыход ПК" FontSize="15" FontWeight="SemiBold" />
                            <ComboBox x:Name="PcAudioBox" PlaceholderText="Выберите выход" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="PcButton" Content="Вернуться к ПК" Click="Pc_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentActionButton}" />
                </StackPanel>

                <StackPanel x:Name="TvPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Настройка ТВ" Style="{StaticResource SectionTitle}" Margin="4,2,0,0" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Телевизор" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Будет активен только выбранный экран." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            <ComboBox x:Name="TelevisionBox" PlaceholderText="Выберите экран" HorizontalAlignment="Stretch" />
                            <Button Content="Сохранить раскладку ТВ" Click="CaptureTv_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="TvVideoPanel" HorizontalContentAlignment="Stretch">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Изображение на ТВ" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Выбранные параметры применяются при каждом запуске «Играть на ТВ»."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <ComboBox x:Name="TvResolutionBox" Header="Разрешение" HorizontalAlignment="Stretch"
                                      SelectionChanged="TvResolution_SelectionChanged" />
                            <ComboBox x:Name="TvRefreshBox" Header="Частота обновления" HorizontalAlignment="Stretch"
                                      SelectionChanged="TvRefresh_SelectionChanged" />
                            <ComboBox x:Name="TvScaleBox" Header="Масштаб только ТВ" HorizontalAlignment="Stretch"
                                      SelectionChanged="TvScale_SelectionChanged" />
                            <TextBlock x:Name="TvVideoStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock x:Name="TvScaleStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <Button Content="Обновить режимы ТВ" Click="RefreshTvVideo_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    </ContentControl>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Аудиовыход ТВ" FontSize="15" FontWeight="SemiBold" />
                            <ComboBox x:Name="TvAudioBox" PlaceholderText="Выберите выход" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Список обновляется при открытии. Выход ТВ можно выбрать заранее со статусом «не подключено»: он может стать доступным после включения экрана. Старые отсутствующие устройства скрыты, кроме текущего выбора." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="После включения экрана ожидаем звук ТВ до 10 секунд. Если он недоступен, используем выбранный аудиовыход ПК. Ошибка звука не возвращает изображение на мониторы." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="TvNetworkProviderBox" Header="Сетевое управление выбранным ТВ" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="LG" />
                        <ComboBoxItem Content="Hisense" />
                    </ComboBox>
                    <Expander x:Name="LgNetworkExpander" Header="LG" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                            <ToggleSwitch x:Name="WakeTelevisionToggle" Header="Пробуждение LG по сети" />
                            <TextBlock Text="Стандартный Wake-on-LAN. Опция LG TV On With Mobile не гарантирует его поддержку."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="Локальный IPv4-адрес ТВ" FontSize="13" />
                            <TextBox x:Name="TelevisionIpBox" PlaceholderText="Например, 192.168.1.50" />
                            <TextBlock Text="MAC-адрес ТВ" FontSize="13" />
                            <TextBox x:Name="TelevisionMacBox" PlaceholderText="Например, AA:BB:CC:DD:EE:FF" />
                            <Button x:Name="CheckTvConnectionButton" Content="Проверить соединение"
                                    Click="CheckTvConnection_Click" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Защищённое управление ТВ" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Name="CertificateStatusText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <Button x:Name="CheckCertificateButton" Content="Проверить сертификат ТВ"
                                    Click="CheckCertificate_Click" HorizontalAlignment="Stretch" />
                            <CheckBox x:Name="AllowInsecureWebOsBox">
                                <TextBlock Text="Разрешить старый режим без шифрования (ключ передаётся открыто)"
                                           TextWrapping="Wrap" FontSize="12" />
                            </CheckBox>
                            <Button x:Name="PairTvButton" Content="Сопрячь телевизор"
                                    Click="PairTv_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="RefreshLgInputsButton" Content="Обновить входы телевизора"
                                    Click="RefreshLgInputs_Click" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="LgInputBox" Header="Вход при переходе на ТВ" HorizontalAlignment="Stretch" />
                            <Button x:Name="CancelLgInputsButton" Content="Отменить обновление входов"
                                    Click="CancelLgInputs_Click" IsEnabled="False" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Включите LG, обновите список, выберите HDMI компьютера и сохраните настройки. Команда «Играть на ТВ» переключит LG с Apple TV или другого источника на выбранный вход. Вход без сигнала тоже можно выбрать. Если LG отклоняет запрос, повторите сопряжение и подтвердите разрешение на телевизоре."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="HisenseNetworkExpander" Header="Hisense" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                            <ToggleSwitch x:Name="WakeHisenseToggle" Header="Пробуждение Hisense по сети" />
                            <TextBlock Text="Включите Wake on LAN в настройках сети телевизора. Для Wi-Fi нужна поддержка Wake on Wireless Network. ПК и ТВ должны быть в одной локальной сети; телевизор должен оставаться в режиме ожидания. Поддержка зависит от модели и прошивки."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <TextBox x:Name="HisenseIpBox" Header="Локальный IPv4-адрес Hisense" PlaceholderText="Например, 192.168.1.60" />
                            <TextBox x:Name="HisenseMacBox" Header="MAC-адрес Hisense" PlaceholderText="Например, AA:BB:CC:DD:EE:FF" />
                            <TextBlock Text="Укажите MAC используемого подключения: у Ethernet и Wi-Fi разные адреса."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <Button x:Name="CheckHisenseConnectionButton" Content="Проверить соединение" Click="CheckHisenseConnection_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="TestHisenseWakeButton" Content="Проверить пробуждение без переключения экранов" Click="TestHisenseWake_Click" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Прямое сопряжение RemoteNOW (тестовая версия для U7QF)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Включите телевизор пультом. При первом сопряжении подтвердите его сертификат и введите PIN с экрана ТВ. Телефон не нужен. Совместимость с вашей прошивкой проверяется этой сборкой."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <Button x:Name="PairHisenseButton" Content="Сопрячь Hisense" Click="PairHisense_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="RefreshHisenseInputsButton" Content="Обновить входы телевизора" Click="RefreshHisenseInputs_Click" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="HisenseInputBox" Header="Вход при переходе на ТВ" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="HisensePairStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <Button x:Name="CancelHisenseButton" Content="Отменить проверку / сопряжение" Click="CancelHisense_Click" IsEnabled="False" HorizontalAlignment="Stretch" />
                            <TextBlock Text="При включённом пробуждении команда «Играть на ТВ» отправит Wake-on-LAN. Если выбран вход, приложение попробует переключить его перед переносом изображения. После сопряжения возврат к мониторам также выключает Hisense по сети: сначала восстанавливаются мониторы, затем проверяется состояние ТВ и отправляется команда питания. Уже спящий ТВ не включается."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="HDMI при включении" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="На VIDAA проверьте: Настройки → Система → Дополнительные настройки → Стартовая страница → Последний источник. Выберите HDMI компьютера перед выключением ТВ. Названия и доступность пунктов зависят от модели. Wake-on-LAN сам не выбирает HDMI."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Expander>
                    <Button x:Name="TvButton" Content="Играть на ТВ" Click="Tv_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentActionButton}" />
                </StackPanel>

                <StackPanel x:Name="ControllerPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Настройка контроллера" Style="{StaticResource SectionTitle}" Margin="4,2,0,0" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Комбинация оверлея" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Геймпад" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <ComboBox x:Name="ControllerBox" HorizontalAlignment="Stretch" SelectionChanged="ControllerBox_SelectionChanged" />
                            <TextBlock Text="Выберите две разные кнопки одного геймпада." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ModifierBox" Grid.Column="0" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Column="1" Text="+" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                                <ComboBox x:Name="TriggerBox" Grid.Column="2" HorizontalAlignment="Stretch" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Запомнить первую" Click="LearnModifier_Click" />
                                <Button Content="Запомнить вторую" Click="LearnTrigger_Click" />
                            </StackPanel>
                            <TextBlock x:Name="HotkeyDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Аварийный возврат на мониторы" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="EmergencyReturnToggle" Header="Хоткей возврата" OnContent="Включён" OffContent="Выключен" Toggled="EmergencyReturn_Toggled" />
                            <ContentControl x:Name="EmergencyReturnOptions" IsEnabled="False" HorizontalContentAlignment="Stretch">
                              <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EmergencyModifierBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Первая кнопка аварийного возврата" />
                                    <TextBlock Grid.Column="1" Text="+" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                                    <ComboBox x:Name="EmergencyTriggerBox" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Вторая кнопка аварийного возврата" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Запомнить первую" Click="LearnEmergencyModifier_Click" />
                                    <Button Content="Запомнить вторую" Click="LearnEmergencyTrigger_Click" />
                                </StackPanel>
                              </StackPanel>
                            </ContentControl>
                            <TextBlock Text="Удерживайте обе кнопки 2 секунды для восстановления сохранённой раскладки ПК. Работает в фоне, пока приложение отвечает и геймпад подключён. Применяется после сохранения настроек." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Подключение" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="ControllerStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#171A22" Padding="18,10">
            <StackPanel Spacing="10">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" MaxHeight="48" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Сохранить настройки" Click="Save_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentActionButton}" />
                    <Button Content="Обновить" Click="Refresh_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#1D2029" BorderBrush="#333642" BorderThickness="0,1,0,0">
            <Grid Margin="10,8,10,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PcNav" Grid.Column="0" Click="PcNav_Click" Background="#343044" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <PathIcon x:Name="PcNavIcon" Data="F0 M3,4 L21,4 L21,17 L3,17 Z M5,6 L5,15 L19,15 L19,6 Z M10,17 L14,17 L14,19 L17,19 L17,20 L7,20 L7,19 L10,19 Z" Width="23" Height="23" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="PcNavText" Text="ПК" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="TvNav" Grid.Column="1" Click="TvNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <PathIcon x:Name="TvNavIcon" Data="F0 M3,6 L21,6 L21,18 L3,18 Z M5,8 L5,16 L19,16 L19,8 Z M10,18 L14,18 L14,20 L17,20 L17,21 L7,21 L7,20 L10,20 Z M8,3 L9,2 L12,4 L15,2 L16,3 L12,6 Z" Width="23" Height="23" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="TvNavText" Text="ТВ" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ControllerNav" Grid.Column="2" Click="ControllerNav_Click" Style="{StaticResource NavButtonStyle}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <PathIcon x:Name="ControllerNavIcon" Data="M7,8 L17,8 C20,8 22,11 22,16 L22,18 C22,20 20,21 18,19 L15,16 L9,16 L6,19 C4,21 2,20 2,18 L2,16 C2,11 4,8 7,8 Z M7,11 L7,15 M5,13 L9,13 M16,11 L16,12 M19,13 L19,14" Width="23" Height="23" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ControllerNavText" Text="Контроллер" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
