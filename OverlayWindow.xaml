<Window
    x:Class="ControllerHelper.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:ControllerHelper.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="OverlayRoot" Background="#B310141E" RequestedTheme="Dark">
        <Grid.Resources>
            <Style x:Key="OverlayCardButton" TargetType="Button">
                <Setter Property="Width" Value="250" />
                <Setter Property="Height" Value="250" />
                <Setter Property="Background" Value="#D9232834" />
                <Setter Property="BorderBrush" Value="#686B7085" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Border Width="390" HorizontalAlignment="Left" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#794A38AD" Offset="0" />
                    <GradientStop Color="#004A38AD" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Width="390" HorizontalAlignment="Right" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                    <GradientStop Color="#714676B3" Offset="0" />
                    <GradientStop Color="#004676B3" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="MenuPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#D91B202B" BorderBrush="#6B67627C" BorderThickness="1"
                CornerRadius="30" Padding="28,30">
            <StackPanel Spacing="22">
                <TextBlock Text="ControllerHelper" FontSize="50" FontWeight="Bold"
                           Foreground="#F7F4FF" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <Grid Width="274" Height="274">
                        <Border x:Name="BackGlow" Background="#574B3AA5" CornerRadius="28" Opacity="0" />
                        <Border x:Name="BackRing" Margin="6" BorderBrush="#B8A6FF" BorderThickness="2"
                                CornerRadius="23" Opacity="0" />
                        <Button x:Name="BackButton" Margin="12" Style="{StaticResource OverlayCardButton}"
                                Click="Back_Click" AutomationProperties.Name="{loc:Localize Key=OverlayPresentation_146}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                                <Grid Width="108" Height="108" HorizontalAlignment="Center">
                                    <Border x:Name="BackIconGlow" Background="#766D55D7" CornerRadius="54" Opacity="0" />
                                    <Viewbox Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="24" Height="24">
                                            <PathIcon x:Name="BackIcon" Data="F0 M3,4 L21,4 L21,17 L3,17 Z M5,6 L5,15 L19,15 L19,6 Z M10,17 L14,17 L14,19 L17,19 L17,20 L7,20 L7,19 L10,19 Z"
                                                      Width="24" Height="24" Foreground="#C3B3FF" />
                                            <PathIcon x:Name="TvIcon" Data="M2,5 L22,5 L22,18 L2,18 Z M4,7 L4,16 L20,16 L20,7 Z M9,19 L15,19 L15,21 L9,21 Z"
                                                      Width="24" Height="24" Foreground="#C3B3FF" Visibility="Collapsed" />
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="BackButtonText" Text="{loc:Localize Key=OverlayPresentation_150}" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="24" FontWeight="SemiBold" Foreground="#F7F4FF" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Width="274" Height="274">
                        <Border x:Name="MonitorGlow" Background="#5143769C" CornerRadius="28" Opacity="0" />
                        <Border x:Name="MonitorRing" Margin="6" BorderBrush="#8ED7FF" BorderThickness="2"
                                CornerRadius="23" Opacity="0" />
                        <Button x:Name="MonitorButton" Margin="12" Style="{StaticResource OverlayCardButton}"
                                Click="Monitor_Click" AutomationProperties.Name="{loc:Localize Key=OverlayPresentation_157}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                                <Grid Width="108" Height="108" HorizontalAlignment="Center">
                                    <Border x:Name="MonitorIconGlow" Background="#65518EBE" CornerRadius="54" Opacity="0" />
                                    <Viewbox Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="M2,5 L15,5 L15,15 L2,15 Z M4,7 L4,13 L13,13 L13,7 Z M6,16 L11,16 L11,18 L6,18 Z M17,7 L23,7 L23,15 L17,15 Z M18,9 L18,13 L22,13 L22,9 Z"
                                                  Width="24" Height="24" Foreground="#A9DDFF" />
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="MonitorButtonText" Text="{loc:Localize Key=OverlayPresentation_159}" TextAlignment="Center"
                                           FontSize="24" FontWeight="SemiBold" Foreground="#F7F4FF" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Width="274" Height="274">
                        <Border x:Name="CloseGlow" Background="#51416F9C" CornerRadius="28" Opacity="0" />
                        <Border x:Name="CloseRing" Margin="6" BorderBrush="#9DD9FF" BorderThickness="2"
                                CornerRadius="23" Opacity="0" />
                        <Button x:Name="CloseButton" Margin="12" Style="{StaticResource OverlayCardButton}"
                                Click="Close_Click" AutomationProperties.Name="{loc:Localize Key=OverlayPresentation_160}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                                <Grid Width="108" Height="108" HorizontalAlignment="Center">
                                    <Border x:Name="CloseIconGlow" Background="#655491BE" CornerRadius="54" Opacity="0" />
                                    <Viewbox Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="M7,4 L20,12 L7,20 Z" Width="24" Height="24" Foreground="#A9DDFF" />
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="CloseButtonText" Text="{loc:Localize Key=OverlayPresentation_162}" TextAlignment="Center"
                                           FontSize="24" FontWeight="SemiBold" Foreground="#F7F4FF" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Width="274" Height="274">
                        <Border x:Name="FlydigiGlow" Background="#5143769C" CornerRadius="28" Opacity="0" />
                        <Border x:Name="FlydigiRing" Margin="6" BorderBrush="#8ED7FF" BorderThickness="2"
                                CornerRadius="23" Opacity="0" />
                        <Button x:Name="FlydigiButton" Margin="12" Style="{StaticResource OverlayCardButton}"
                                Click="Flydigi_Click" AutomationProperties.Name="{loc:Localize Key=OverlayWindow_353}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                                <Grid Width="108" Height="108" HorizontalAlignment="Center">
                                    <Border x:Name="FlydigiIconGlow" Background="#65518EBE" CornerRadius="54" Opacity="0" />
                                    <Viewbox Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="M7,8 L17,8 L21,13 L19,18 L16,17 L14,15 L10,15 L8,17 L5,18 L3,13 Z M8,10 L8,14 M6,12 L10,12 M15,11 L16,11 M18,13 L19,13"
                                                  Width="24" Height="24" Foreground="#A9DDFF" />
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Flydigi" TextAlignment="Center" FontSize="24"
                                           FontWeight="SemiBold" Foreground="#F7F4FF" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="MonitorErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                           MaxWidth="850" HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="18" Foreground="#FF9BAB" />
                <Grid Height="88">
                    <Border x:Name="TelegramGlow" Background="#5143769C" CornerRadius="22" Opacity="0" />
                    <Border x:Name="TelegramRing" Margin="5" BorderBrush="#8ED7FF" BorderThickness="2"
                            CornerRadius="18" Opacity="0" />
                    <Button x:Name="TelegramButton" Margin="10" Height="68" HorizontalAlignment="Stretch"
                            Background="#D9232834" BorderBrush="#686B7085" BorderThickness="1"
                            CornerRadius="15" Click="Telegram_Click" AutomationProperties.Name="{loc:Localize Key=OverlayWindow_354}">
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Cancel" Foreground="#A9DDFF" />
                            <TextBlock Text="{loc:Localize Key=OverlayWindow_354}" FontSize="23" FontWeight="SemiBold"
                                       Foreground="#F7F4FF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
        <Grid x:Name="FlydigiPanel" Visibility="Collapsed" Margin="24,16,24,20" RowDefinitions="Auto,*,Auto"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,12">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <TextBlock Text="ControllerHelper · Flydigi" FontSize="30" FontWeight="SemiBold" Foreground="#F7F4FF" />
                    <TextBlock Text="{loc:Localize Key=OverlayWindow_355}" FontSize="20" Foreground="#A9DDFF"
                               VerticalAlignment="Center" />
                </StackPanel>
                </Viewbox>
                <Button x:Name="FlydigiCloseButton" Grid.Column="1" Click="FlydigiClose_Click"
                        Background="#D9232834" BorderBrush="#8ED7FF" BorderThickness="1" CornerRadius="12"
                        Padding="18,10" AutomationProperties.Name="{loc:Localize Key=OverlayWindow_356}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <SymbolIcon Symbol="Cancel" Foreground="#A9DDFF" />
                        <TextBlock Text="{loc:Localize Key=OverlayWindow_356}" FontSize="19" Foreground="#F7F4FF" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border x:Name="FlydigiViewport" Grid.Row="1" Background="#E51B202B" BorderBrush="#8ED7FF"
                    BorderThickness="2" CornerRadius="18" />
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="20,10" Background="#D9232834"
                    BorderBrush="#686B7085" BorderThickness="1" CornerRadius="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Key=OverlayWindow_357}" FontSize="20" Foreground="#F7F4FF"
                               VerticalAlignment="Center" />
                    <Slider x:Name="FlydigiSpeedSlider" Grid.Column="1" Minimum="0.25" Maximum="2.5"
                            StepFrequency="0.05" SmallChange="0.05" LargeChange="0.25"
                            ValueChanged="FlydigiSpeedSlider_ValueChanged"
                            VerticalAlignment="Center" AutomationProperties.Name="{loc:Localize Key=OverlayWindow_358}" />
                    <TextBlock x:Name="FlydigiSpeedValue" Grid.Column="2" Width="64" FontSize="20"
                               Foreground="#A9DDFF" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
