<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>controller.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ControllerHelper</AssemblyName>
    <RootNamespace>ControllerHelper</RootNamespace>
    <Version>1.1.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish*/**;.work/**;.dotnet-cli/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <EmbeddedResource Include="ThirdParty/Hisense/*_client.*" />
    <EmbeddedResource Include="Localization/*.json" LogicalName="ControllerHelper.Localization.%(Filename)%(Extension)" />
    <Content Include="ThirdParty/Hisense/LICENSE*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdParty/Hisense/NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="controller.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="controller.svg" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Launcher/**/*.cs" />
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
